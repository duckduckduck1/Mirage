[Unit]
Description=Mirage nightly server status to the administrator Telegram chat
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/mirage/infra/status.py --config /etc/mirage/host.json
CPUQuota=30%
CPUWeight=20
MemoryMax=64M
TimeoutStartSec=3min
Restart=no
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
