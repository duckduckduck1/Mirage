# Safe first-run defaults: test project, loopback only, alternate ports.
# Copy outside Git; configure the panel's inbounds with these same ports.
COMPOSE_PROJECT_NAME=mirage-test
XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v3.10.2@sha256:6c7e73c5bc4b6d7d70866616f78d6c9866b4904defad3077c1e2b5c1c89c2ec1
# Existing Caddy version/digest inventoried during VPS preparation, 2026-10-24.
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
PUBLIC_HOST=vpn.example.com
BIND_IP=127.0.0.1
PANEL_PORT=12080
TCP_PORT=24443
GRPC_PORT=28443
XHTTP_PORT=22053
TROJAN_PORT=29443
SUB_HTTPS_PORT=22096
DB_DIR=/var/lib/mirage-test/db
TLS_DIR=/var/lib/mirage-test/tls
